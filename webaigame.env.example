# WebAIGame 服务端环境变量模板
# 复制到服务器 /etc/webaigame/webaigame.env 后按需填写。

# 监听地址与端口
WEB_AI_GAME_HOST=0.0.0.0
WEB_AI_GAME_PORT=8000

# 房间空置回收时长（毫秒）：房间连续这么久没有任何操作（无人加入/提交/出牌等）就自动解散。
# 默认 900000（15 分钟），最低 60000（1 分钟）。只有玩家真实操作（点击界面/出牌/提交）才刷新空置计时。
# WEB_AI_GAME_ROOM_IDLE_MS=900000
# 在线判定：客户端心跳超时（毫秒），全员离线时房间会被销毁；暂停中的房间不销毁。默认 90000（90 秒）。
# WEB_AI_GAME_OFFLINE_MS=90000

# AI 生成方式：不填 Key 走本地兜底；填了 Key 则用于服务器端 AI 生成。
# LLM_PROVIDER 可选：deepseek / qwen / openai
# DEEPSEEK_API_KEY=sk-xxxxxxxx
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
